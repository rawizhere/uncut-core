# ==============================================================================
# Uncut Core Configuration
# ==============================================================================

# Server Domain & Email for TLS (Required)
DOMAIN=example.com
EMAIL=admin@example.com

# Server Geolocation & Timezone (Optional, Defaults: Country=US, TZ=Europe/Moscow)
COUNTRY=US
TZ=Europe/Moscow

# Logging level: debug, info, warn, error (Optional, Default: info)
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# ZeroSSL ACME EAB Credentials (Optional)
# If provided, ZeroSSL is used as the primary CA instead of Let's Encrypt.
# Obtain from: https://app.zerossl.com/developer
# ------------------------------------------------------------------------------
ZEROSSL_EAB_KID=
ZEROSSL_EAB_HMAC=
