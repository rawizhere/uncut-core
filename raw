#!/bin/bash

#############################################

# Detect script location
export SCRIPT_PATH=$(readlink -f "$0")
export SCRIPT_DIR=$(dirname "$SCRIPT_PATH")

# Source Core
source "$SCRIPT_DIR/core/utils.sh"
source "$SCRIPT_DIR/core/config.sh"
source "$SCRIPT_DIR/core/network.sh"
source "$SCRIPT_DIR/core/menu.sh"

# Source Modules
source "$SCRIPT_DIR/modules/acme.sh"
source "$SCRIPT_DIR/modules/nginx.sh"
source "$SCRIPT_DIR/modules/singbox.sh"
source "$SCRIPT_DIR/modules/protocols.sh"
source "$SCRIPT_DIR/modules/users.sh"
source "$SCRIPT_DIR/modules/mtproto.sh"
source "$SCRIPT_DIR/modules/shadowtls.sh"

# Setup Trap
trap 'echo -e "\n${YELLOW}Exiting...${NC}"; exit 0' INT TERM

# Main entry point
main() {
    check_root
    check_os
    
    # Initialize settings if missing
    if [[ -d "$INSTALL_DIR" ]]; then
        local salt=$(get_setting "protocol_salt")
        if [[ -z "$salt" ]]; then
            init_settings
        fi
    fi
    
    check_script_updates
    migrate_clients_to_v2
    
    # Handle Unattended Mode
    if [[ "$1" == "--auto" || "$UNATTENDED" == "true" ]]; then
        if ! is_installed; then
            install_singbox
        else
            print_info "Sing-box is already installed. Running system migration..."
            run_system_migration
        fi
        exit 0
    fi
    
    while true; do
        show_menu
        if ! read -p "Your choice: " choice; then
            echo -e "\n${RED}Error: Cannot read input. Try running 'raw' directly.${NC}"
            exit 1
        fi
        
        case "$choice" in
            1) add_client ;;
            2) edit_client ;;
            3) remove_client ;;
            4) list_clients ;;
            5) show_client_links ;;
            6) add_protocol ;;
            7) remove_protocol ;;
            8) list_protocols ;;
            9) change_sni ;;
            10) rotate_masking_salt ;;
            11) check_system_health ;;
            12) restart_service ;;
            13) show_logs ;;
            14) install_acme_sh --force ;;
            15) mtproto_menu ;;
            16) update_singbox ;;
            17) toggle_auto_update ;;
            18) change_singbox_version ;;
            19) install_singbox ;;
            20) uninstall_singbox ;;
            0) exit 0 ;;
            *) [[ -n "$choice" ]] && print_error "Invalid choice" ;;
        esac
        
        if [[ "$choice" != "0" ]]; then
            echo ""
            read -p "Press Enter to continue..."
        fi
    done
}

main "$@"
